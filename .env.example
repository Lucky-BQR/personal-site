# Public browser configuration. These values are safe to expose and are
# injected into the GitHub Pages bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the
# publishable key. Do not configure both unless they identify the same project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
